# SEO Health Monitor configuration. Copy to .env.local (development) or
# .env.production (deployment). Every key is optional in development; see
# docs/deployment.md for what production requires.

# --- Security -----------------------------------------------------------------
# Signs sessions/OAuth state and encrypts stored Google tokens. Required for
# sign-in and Search Console. Generate with: openssl rand -base64 32
# Changing it signs everyone out and requires reconnecting Search Console.
APP_SECRET=
# Owner password (12+ characters). Required in production unless AUTH_DISABLED=true.
# In development, leaving it empty runs the app without sign-in.
AUTH_PASSWORD=
# Only set to true if the app sits behind your own authenticating proxy (SSO).
AUTH_DISABLED=
# Public URL of the app (used for the Google OAuth redirect URI and origin checks).
APP_URL=http://localhost:3000
# Number of reverse proxies in front of the app that append X-Forwarded-For
# (e.g. 1 for nginx/Caddy). Leave 0 if the app is reached directly.
TRUST_PROXY=0

# --- Google PageSpeed Insights --------------------------------------------------
# https://developers.google.com/speed/docs/insights/v5/get-started
# Without a key Google applies a tiny shared quota and most tests fail with HTTP 429.
PAGESPEED_API_KEY=
# Pages per audit to test (each on mobile and desktop).
PAGESPEED_MAX_PAGES=3

# --- Google Search Console (OAuth, read-only) -----------------------------------
# OAuth client of type "Web application" with redirect URI:
#   ${APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Pages per snapshot sent to the URL Inspection API (quota ~2,000/day/property).
GSC_MAX_INSPECTIONS=25

# --- AI consultant (optional) ---------------------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Storage --------------------------------------------------------------------
DATABASE_PATH=./data/seo-health.db

# --- Crawler and limits ---------------------------------------------------------
CRAWL_MAX_PAGES=25
CRAWL_CONCURRENCY=2
CRAWL_TIMEOUT_MS=15000
CRAWL_MAX_BYTES=3000000
# Audits per client per window, plus a global cap across all clients.
AUDIT_RATE_LIMIT_MAX=5
AUDIT_RATE_LIMIT_GLOBAL_MAX=30
AUDIT_RATE_LIMIT_WINDOW_MS=600000

# Concurrent full audits (1 recommended for the initial Railway service; max 2).
AUDIT_CONCURRENCY=2

# --- Phase 2 customer beta (staging only; leave unset in production) -------------
# Off unless PHASE2_ENABLED=true. Refuses to start if AUTH_DISABLED=true, if the
# owner area has no AUTH_PASSWORD in production, or if PHASE2_DATABASE_URL equals
# DATABASE_URL / PRODUCTION_DATABASE_URL. See docs/phase2/staging-setup.md.
PHASE2_ENABLED=
# Unified mode retires global SQLite/owner auth and maps existing bookmarks to tenant routes.
# Keep off on Phase 1 until backup, import and cutover are explicitly approved.
PHASE2_UNIFIED=
# Separate PostgreSQL database (pglite://./data/phase2-dev is local development only).
PHASE2_DATABASE_URL=
# Canonical public origin, e.g. https://seo-beta-staging.up.railway.app (no path).
PHASE2_ORIGIN=
# 32+ random characters, different from APP_SECRET (openssl rand -hex 32).
PHASE2_AUTH_SECRET=
# closed (default) or invite-only. Unrestricted public registration is not supported.
PHASE2_REGISTRATION=closed
# Administrator kill switch for new invitations (default false).
PHASE2_INVITATIONS_ENABLED=false
PHASE2_INVITATION_TTL_HOURS=72
# Only set after verifying the proxy overwrites this header (otherwise all clients share one limiter).
PHASE2_TRUSTED_IP_HEADER=
# Transactional email: resend (required in production) or log (development only).
EMAIL_TRANSPORT=
RESEND_API_KEY=
EMAIL_FROM=
# Staging guard: comma-separated addresses or @domains allowed to receive email.
EMAIL_RECIPIENT_ALLOWLIST=

# --- Customer beta: audit worker and free-beta resource limits (Stage 3) ---
# Worker: "in-process" runs it inside the web server; leave empty and run
# `npm run worker:beta` as a separate service instead. Never set in production yet.
PHASE2_WORKER=
PHASE2_WORKER_CONCURRENCY=1
# Per-account defaults (an administrator override on the tenant row takes precedence).
PHASE2_LIMIT_WEBSITES=2
PHASE2_LIMIT_AUDITS_PER_MONTH=5
PHASE2_LIMIT_PAGES_PER_SCAN=25
PHASE2_LIMIT_CONCURRENT_SCANS=1
PHASE2_LIMIT_PAGESPEED_PER_MONTH=60
PHASE2_LIMIT_AI_PER_MONTH=5
# Shared across all accounts and worker processes.
PHASE2_GLOBAL_MAX_RUNNING=2
PHASE2_GLOBAL_MAX_QUEUED=50
PHASE2_GLOBAL_PAGESPEED_PER_DAY=400
PHASE2_GLOBAL_AI_PER_DAY=50
PHASE2_PAGESPEED_PAGES_PER_AUDIT=3

# Customer Search Console (G5). A separate client is the default; explicit existing-client
# reuse is supported below. Default authorised redirect URI:
#   ${PHASE2_ORIGIN}/api/beta/google/callback
# Scopes requested: openid, email, webmasters.readonly. Set the same values on the worker.
# In PHASE2_UNIFIED=true mode the callback preserves /api/integrations/google/callback.
PHASE2_GOOGLE_CLIENT_ID=
PHASE2_GOOGLE_CLIENT_SECRET=
# Explicit operator opt-in to existing GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET. Shared-client
# disconnect is local only, preserving grants used by another deployment or tenant.
PHASE2_GOOGLE_REUSE_LEGACY_CLIENT=
# Encrypts stored refresh tokens (32+ random characters; must differ from APP_SECRET and
# PHASE2_AUTH_SECRET). Changing it makes every stored connection ask to reconnect.
PHASE2_GOOGLE_TOKEN_SECRET=
# URL Inspection calls per refresh or audit (Google allows ~2,000/day per property).
PHASE2_GSC_MAX_INSPECTIONS=10

# G6 privacy notices. Confirm an operator-owned address before external beta invitations.
PHASE2_PRIVACY_CONTACT_EMAIL=
# Retention is PREVIEW-ONLY until the policy is reviewed and this exact revision is set.
PHASE2_RETENTION_APPROVED_REVISION=
PHASE2_RETENTION_AUDITS_DAYS=180
PHASE2_RETENTION_SCAN_LOGS_DAYS=30
PHASE2_RETENTION_FAILED_JOBS_DAYS=30
PHASE2_RETENTION_AUTH_EVENTS_DAYS=90
PHASE2_RETENTION_INVITATIONS_DAYS=90
PHASE2_RETENTION_SEARCH_SNAPSHOTS_DAYS=90
PHASE2_RETENTION_GENERATED_REPORTS_DAYS=180
PHASE2_RETENTION_DELETION_RECORDS_DAYS=90
PHASE2_RETENTION_OPERATIONAL_EVENTS_DAYS=30
PHASE2_RETENTION_ACTIVITY_DAYS=90
PHASE2_RETENTION_BACKUPS_DAYS=30
# Separate encryption secret for operator backups, supplied by a private secret store.
BETA_BACKUP_ENCRYPTION_SECRET=
# Required only for restore; encrypted, current deletion ledger stored outside the live DB.
BETA_DELETION_LEDGER_FILE=
