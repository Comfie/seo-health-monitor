# SEO Health Monitor configuration. Copy to .env.local and fill in what you need.
# Every key is optional: the app runs without any of them and reports the
# affected checks as "unavailable" instead of inventing results.

# Google PageSpeed Insights API key (https://developers.google.com/speed/docs/insights/v5/get-started).
# Without a key, Google applies a very small shared quota and most requests fail with HTTP 429.
PAGESPEED_API_KEY=

# Anthropic API key for the optional AI SEO Consultant.
ANTHROPIC_API_KEY=
# Model used for the AI consultant (defaults to claude-opus-5-5).
AI_MODEL=claude-opus-5-5

# SQLite database file (relative to the project root).
DATABASE_PATH=./data/seo-health.db

# Crawler limits.
CRAWL_MAX_PAGES=25
CRAWL_CONCURRENCY=2
CRAWL_TIMEOUT_MS=15000
CRAWL_MAX_BYTES=3000000
# Number of pages to test with PageSpeed Insights (each is tested on mobile and desktop).
PAGESPEED_MAX_PAGES=3

# Rate limit for starting audits, per client IP.
AUDIT_RATE_LIMIT_MAX=5
AUDIT_RATE_LIMIT_WINDOW_MS=600000

# Future: Google Search Console OAuth (not used yet, see docs/search-console.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
