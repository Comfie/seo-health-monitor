# SEO Health Monitor configuration. Copy to .env.local (development) or
# .env.production (deployment). Every key is optional in development; see
# docs/deployment.md for what production requires.

# --- Security -----------------------------------------------------------------
# Signs sessions/OAuth state and encrypts stored Google tokens. Required for
# sign-in and Search Console. Generate with: openssl rand -base64 32
# Changing it signs everyone out and requires reconnecting Search Console.
APP_SECRET=
# Owner password (12+ characters). Required in production unless AUTH_DISABLED=true.
# In development, leaving it empty runs the app without sign-in.
AUTH_PASSWORD=
# Only set to true if the app sits behind your own authenticating proxy (SSO).
AUTH_DISABLED=
# Public URL of the app (used for the Google OAuth redirect URI and origin checks).
APP_URL=http://localhost:3000
# Number of reverse proxies in front of the app that append X-Forwarded-For
# (e.g. 1 for nginx/Caddy). Leave 0 if the app is reached directly.
TRUST_PROXY=0

# --- Google PageSpeed Insights --------------------------------------------------
# https://developers.google.com/speed/docs/insights/v5/get-started
# Without a key Google applies a tiny shared quota and most tests fail with HTTP 429.
PAGESPEED_API_KEY=
# Pages per audit to test (each on mobile and desktop).
PAGESPEED_MAX_PAGES=3

# --- Google Search Console (OAuth, read-only) -----------------------------------
# OAuth client of type "Web application" with redirect URI:
#   ${APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Pages per snapshot sent to the URL Inspection API (quota ~2,000/day/property).
GSC_MAX_INSPECTIONS=25

# --- AI consultant (optional) ---------------------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Storage --------------------------------------------------------------------
DATABASE_PATH=./data/seo-health.db

# --- Crawler and limits ---------------------------------------------------------
CRAWL_MAX_PAGES=25
CRAWL_CONCURRENCY=2
CRAWL_TIMEOUT_MS=15000
CRAWL_MAX_BYTES=3000000
# Audits per client per window, plus a global cap across all clients.
AUDIT_RATE_LIMIT_MAX=5
AUDIT_RATE_LIMIT_GLOBAL_MAX=30
AUDIT_RATE_LIMIT_WINDOW_MS=600000
