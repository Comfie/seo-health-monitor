{
  "name": "seo-health-monitor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/ && node --env-file-if-exists=.env.production --env-file-if-exists=.env.local .next/standalone/server.js",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "audit:cli": "tsx --conditions=react-server scripts/audit-cli.ts",
    "db:backup": "node scripts/sqlite-backup.cjs backup",
    "db:restore": "node scripts/sqlite-backup.cjs restore",
    "test:railway": "node scripts/test-railway.cjs",
    "db:saas:generate": "drizzle-kit generate --config=drizzle.saas.config.ts",
    "db:saas:staging": "tsx --conditions=react-server scripts/saas-staging.ts",
    "worker:beta": "tsx --conditions=react-server scripts/beta-worker.ts",
    "test:saas": "vitest run tests/saas.test.ts tests/saas-migration.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "robots-parser": "^3.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
