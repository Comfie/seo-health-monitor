# syntax=docker/dockerfile:1
# Customer beta audit worker (Phase 2). Runs scripts/beta-worker.ts against PostgreSQL only:
# no HTTP port, no volume, no Phase 1 SQLite data. The Next.js standalone image does not contain
# the worker, so it is bundled here into one ES module that imports only runtime dependencies.

FROM node:22-bookworm-slim AS deps
WORKDIR /app
# Toolchain for better-sqlite3 (a runtime dependency of the package) if no prebuilt binary matches.
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
# Runtime dependencies only: no lint, component-CLI or test tooling in the final image.
RUN npm ci --omit=dev && npm cache clean --force

FROM deps AS build
WORKDIR /app
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
COPY scripts/beta-worker.ts ./scripts/beta-worker.ts
# esbuild arrives with tsx. Packages stay external (resolved from the runtime node_modules);
# the "@/..." source aliases are resolved through tsconfig.json.
RUN npx --no-install esbuild scripts/beta-worker.ts --bundle --platform=node --target=node22 --format=esm \
      --conditions=react-server --packages=external --outfile=dist/beta-worker.mjs

FROM node:22-bookworm-slim AS run
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1
RUN useradd --system --uid 1001 --home /app app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json
COPY --from=build /app/dist/beta-worker.mjs ./dist/beta-worker.mjs
USER app
# Node runs as PID 1 and receives SIGTERM directly (no npm wrapper), so the worker can hand its
# jobs back within the platform's draining window. react-server selects the server build of
# "server-only" and friends, exactly as the web server does.
CMD ["node", "--conditions=react-server", "dist/beta-worker.mjs"]
